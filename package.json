{
  "name": "hh-job-apply-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup": "prisma generate && prisma migrate deploy && playwright install chromium",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:resume": "node scripts/smoke-resume.mjs",
    "smoke:auto": "node scripts/smoke-auto-apply.mjs",
    "smoke:workspace": "node scripts/smoke-workspace.mjs",
    "smoke:profiles": "node scripts/smoke-profiles.mjs",
    "smoke:inbox": "node scripts/smoke-inbox.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@prisma/engines": true,
    "prisma": true,
    "unrs-resolver": true,
    "fsevents": false
  }
}
