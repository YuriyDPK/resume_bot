generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vacancy {
  profileId     Int           @default(1)
  id            Int           @id @default(autoincrement())
  externalId    String?
  title         String
  company       String
  salary        String?
  city          String?
  url           String
  description   String?
  matchScore    Int           @default(0)
  status        String        @default("found")
  searchBatchId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]

  @@index([status])
  @@index([matchScore])
  @@index([createdAt])
  @@index([searchBatchId])
  @@unique([profileId, url])
  @@index([profileId, status])
}

model SeenVacancy {
  profileId   Int      @default(1)
  id          Int      @id @default(autoincrement())
  url         String
  externalId  String?
  firstSeenAt DateTime @default(now())

  @@unique([profileId, url])
}

model Application {
  id          Int       @id @default(autoincrement())
  vacancyId   Int
  vacancy     Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  coverLetter String?
  status      String    @default("pending")
  error       String?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([appliedAt])
}

model Setting {
  hhAccountId          String?
  resumeVerifiedAt     DateTime?
  name                 String   @default("Основное резюме")
  id                   Int      @id @default(1)
  city                 String   @default("")
  minSalary            Int?
  coverLetterTemplate  String   @default("Здравствуйте! Заинтересовала ваша вакансия. Буду рад обсудить, чем мой опыт может быть полезен команде.")
  resumeText           String   @default("")
  resumeUrl            String?
  excludedWords        String   @default("")
  browserHeadless      Boolean  @default(true)
  dailyLimit           Int      @default(5)
  searchLimit          Int      @default(50)
  searchAllRussia      Boolean  @default(true)
  remoteOnly           Boolean  @default(false)
  activeSearchBatchId  String?
  searchDelayMinSeconds Int     @default(1)
  searchDelayMaxSeconds Int     @default(3)
  applyDelayMinSeconds Int      @default(3)
  applyDelayMaxSeconds Int      @default(8)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SearchKeyword {
  profileId Int      @default(1)
  id        Int      @id @default(autoincrement())
  value     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, value])
}

model Log {
  profileId Int      @default(1)
  id        Int      @id @default(autoincrement())
  level     String   @default("info")
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([level])
  @@index([createdAt])
}

model AppState {
  id              Int @id @default(1)
  activeProfileId Int @default(1)
}

model Conversation {
  id             Int      @id @default(autoincrement())
  accountId      String
  externalId     String
  vacancyUrl     String?
  vacancyTitle   String
  company        String
  resumeId       String?
  outcome        String   @default("neutral")
  statusLabel    String   @default("")
  unread         Boolean  @default(false)
  lastMessage    String   @default("")
  messagesJson   String   @default("[]")
  hhUrl          String
  lastMessageAt  DateTime?
  syncedAt       DateTime @default(now())

  @@unique([accountId, externalId])
  @@index([accountId, outcome])
  @@index([accountId, lastMessageAt])
}
